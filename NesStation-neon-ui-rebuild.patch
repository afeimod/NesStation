+        Spacer(Modifier.height(3.dp))
+        Text(label, color = tint, fontSize = 9.sp, fontWeight = FontWeight.Medium, maxLines = 1)
+    }
+}
+
+/** Neon 搜索输入框（游戏库顶栏内嵌，深色底 + 青色光标）。 */
+@Composable
+fun NeonSearchField(
+    value: String,
+    onValueChange: (String) -> Unit,
