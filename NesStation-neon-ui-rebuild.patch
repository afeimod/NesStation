+                Text("将从游戏库移除「${game.customTitle?.takeIf { it.isNotBlank() } ?: game.title}」。\n（ROM 文件本身不会被删除，可随时重新导入）")
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    try {
+                        RomStore.remove(context, game.id)
+                        onGamesChanged()
+                    } catch (_: Exception) { }
+                    pendingDeleteGame = null
+                }) { Text("删除", color = Neon.Red) }
