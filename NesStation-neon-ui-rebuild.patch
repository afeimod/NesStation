+/** 格式化游戏时长（playTimeMs → "3.2小时" / "42分钟" / "—")。 */
+fun neonFormatPlayTime(ms: Long): String = when {
+    ms <= 0L -> "—"
+    ms < 60 * 60 * 1000L -> "${ms / 60_000L}分钟"
+    else -> String.format("%.1f小时", ms / 3_600_000.0)
