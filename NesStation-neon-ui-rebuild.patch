+/** 格式化「最近游玩」相对时间。 */
+fun neonFormatLastPlayed(ts: Long, now: Long = System.currentTimeMillis()): String = when {
+    ts <= 0L -> "未游玩"
+    now - ts < 60_000L -> "刚刚"
+    now - ts < 3_600_000L -> "${(now - ts) / 60_000L}分钟前"
+    now - ts < 86_400_000L -> "${(now - ts) / 3_600_000L}小时前"
+    now - ts < 30L * 86_400_000L -> "${(now - ts) / 86_400_000L}天前"
+    else -> "很久以前"
+}
