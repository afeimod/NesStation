+static void ensurePatchedRomDirs() {
+    if (s_systemDir.empty()) return;
+    std::string base = s_systemDir;
+    if (!base.empty() && base.back() != '/') base += '/';
+    base += "fbneo/";
+    std::string patched = base + "patched";
+    std::string ips = base + "ips";
