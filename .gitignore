# Gradle
.gradle/
build/
**/build/
# Vendored zstd/lz4 CMake build scripts must stay tracked: their top-level
# CMakeLists.txt does add_subdirectory(build/cmake).
!ARMSX2-master/platforms/android/app/src/main/cpp/3rdparty/zstd/build/
!ARMSX2-master/platforms/android/app/src/main/cpp/3rdparty/zstd/build/**
!ARMSX2-master/platforms/android/app/src/main/cpp/3rdparty/lz4/build/
!ARMSX2-master/platforms/android/app/src/main/cpp/3rdparty/lz4/build/**
local.properties
gradle-app.setting
.gradletasknamecache
.kotlin/

# IDEA
.idea/
*.iml
*.iws
*.ipr
out/
# Eden 源码树中 audio_core/out/ 是真实源码目录（非 IDE 构建输出），
# 必须放行纳入跟踪，否则干净 clone/CI 会报
# "Cannot find source file: out/audio_out.cpp"
!core/eden/src/audio_core/out/
!core/eden/src/audio_core/out/**

# Android
captures/
*.apk
*.aab
*.ap_
*.dex
.cxx/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
hs_err_pid*
replay_pid*

# NDK
obj/

# Temp downloads (shaderc dep tarballs etc.) — never commit
.tmp_dl/
